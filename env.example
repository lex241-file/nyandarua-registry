# Copy this file to .env and fill in real values. NEVER commit the real .env file.

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=registry_app
DB_PASSWORD=change_me
DB_NAME=nyandarua_registry
DB_CONNECTION_LIMIT=10
# Set to true for managed MySQL-compatible hosts that require TLS
# (TiDB Cloud, PlanetScale, Aiven, etc.) Leave unset/false for a plain
# local or VPS-hosted MySQL that doesn't use TLS.
DB_SSL=false

# Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=8h

# Rate limiting (login attempts per window per IP)
LOGIN_RATE_LIMIT_WINDOW_MIN=15
LOGIN_RATE_LIMIT_MAX=10
